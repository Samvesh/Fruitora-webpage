# ── Local Development ──────────────────────────────────────────────────────────
PORT=5050
NODE_ENV=development

# MongoDB: use a local instance for dev, or your Atlas URI
# Local:   mongodb://127.0.0.1:27017/fruit-nutrition-platform
# Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fruitora
MONGODB_URI=mongodb://127.0.0.1:27017/fruit-nutrition-platform

JWT_SECRET=replace-this-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d

# Frontend origin (comma-separated for multiple)
CLIENT_URL=http://localhost:5173

# ── Optional External APIs ─────────────────────────────────────────────────────
USDA_API_KEY=DEMO_KEY
GOOGLE_TRENDS_API_URL=
GOOGLE_TRENDS_API_KEY=
FAOSTAT_API_URL=https://fenixservices.fao.org/faostat/api/v1
